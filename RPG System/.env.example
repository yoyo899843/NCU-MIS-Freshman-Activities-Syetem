POSTGRES_USER=rpgsystem
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=rpgsystem

# 用來簽發 JWT，建議用一長串隨機字串（例如 openssl rand -hex 32）。
# 跟 Time-Space Warfare 的 JWT_SECRET 各自獨立，不要共用同一組。
JWT_SECRET=change-me-to-a-long-random-string

# 只有 scripts/download-tiles.js（活動籌備期間手動執行一次的地圖圖磚下載工具）會用到，
# app 執行期間不需要。申請：https://carto.com/basemaps/apikey/（免審核、免帳號、免費額度
# 每月 500 萬次請求，一次性下載幾十張圖用不到零頭）。
CARTO_API_KEY=change-me-to-your-carto-api-key
